{
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "bracketSameLine": true,
  "bracketSpacing": false,
  "objectWrap": "preserve",
  "singleAttributePerLine": false,
  "arrowParens": "always"
}